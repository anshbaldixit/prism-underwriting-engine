# Copy to .env (git-ignored). Nothing in this file is optional for a real run except the AI keys.
PRISM_DB_PASSWORD=change-me-local-db-password
# At least 32 characters. Generate: openssl rand -base64 48
PRISM_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Password for the seeded demo users (applicant / underwriter / admin). Leave blank to have one generated and logged once.
PRISM_SEED_PASSWORD=prism-demo-2026

# AI layer: offline needs no credentials. bedrock needs AWS creds + model access; anthropic needs ANTHROPIC_API_KEY.
PRISM_AI_PROVIDER=offline            # bedrock | anthropic | offline
PRISM_EMBEDDING_PROVIDER=offline     # bedrock | offline
AWS_REGION=us-east-1
PRISM_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
PRISM_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
PRISM_BEDROCK_GUARDRAIL_ID=
PRISM_BEDROCK_GUARDRAIL_VERSION=DRAFT
# AWS credentials: prefer `aws configure` / SSO / an IAM role. Only set these for a throwaway sandbox account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Anthropic API alternative
ANTHROPIC_API_KEY=
PRISM_ANTHROPIC_MODEL=claude-opus-5
